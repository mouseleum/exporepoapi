# Supabase — Phase 1: only the loader needs the service-role key.
# The anon key is reserved for the future Library UI (Phase 4) and is unused for now.
SUPABASE_URL=https://hihhgpzcklusonxnbfcn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot OAuth (Phase 9) — only needed if you want HubSpot signals on
# /library/companies. Create an OAuth app at developers.hubspot.com, register
# the redirect URI (http://localhost:3000/api/auth/hubspot/callback for dev,
# https://exporepoapi.vercel.app/api/auth/hubspot/callback for prod) and copy
# the client id + secret here. HUBSPOT_REDIRECT_URI is optional — when unset
# we derive it from the request origin, which is what you want unless you're
# behind a proxy that rewrites the host.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
