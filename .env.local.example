# Supabase — Phase 1: only the loader needs the service-role key.
# The anon key is reserved for the future Library UI (Phase 4) and is unused for now.
SUPABASE_URL=https://hihhgpzcklusonxnbfcn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot Private App (Phase 9) — only needed for HubSpot signals on
# /library/companies. Create a Private App inside your HubSpot CRM portal:
# Settings → Integrations → Private Apps → Create. Grant read scopes for
# companies, contacts, deals, owners, deal pipelines, and emails. Copy the
# generated bearer token here. HUBSPOT_OWNER_EMAIL is optional but needed
# for met-by-you vs met-by-team distinction — set it to your HubSpot
# user email; sync will look up your owner_id on first run.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_OWNER_EMAIL=
